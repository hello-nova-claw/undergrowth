#: src/settings.php
msgid "OpenAI API key"
msgstr ""

#: src/settings.php
msgid "With a key saved, the title and text of each published post are sent to OpenAI to be turned into vectors, which Undergrowth uses to suggest links between your posts. Nothing is sent until you save a key. Undergrowth never writes or changes your posts."
msgstr ""

#. translators: %s: last four characters of the saved API key.
#: src/settings.php
#, php-format
msgid "A key ending in %s is saved. Leave the field blank to keep it."
msgstr ""

#: src/settings.php
msgid "Remove the saved key and stop sending posts to OpenAI"
msgstr ""

#. translators: 1: date and time, 2: HTTP status code, or 0 when there was no response.
#: src/settings.php
#, php-format
msgid "The last request to OpenAI failed on %1$s (status %2$s). Posts are tried again the next time they are saved."
msgstr ""

#: src/settings.php
msgid "Anthropic API key"
msgstr ""

#: src/settings.php
msgid "With a key saved, Undergrowth asks Claude, through the Anthropic API, to write you an occasional question about your own writing. Each request sends one post’s title, a few sentences quoted from that post and, when the question comes from a reader’s comment, the text of that comment. Whole posts are never sent. A question about a post you moved to compost is sent back once more, on its own, to check it. Nothing is sent until you save a key. The questions appear only on your Dashboard, never to your readers."
msgstr ""

#: src/settings.php
msgid "Remove the saved key and stop sending anything to Anthropic"
msgstr ""

#. translators: 1: date and time, 2: HTTP status code, or 0 when there was no response.
#: src/settings.php
#, php-format
msgid "The last request to Anthropic failed on %1$s (status %2$s). Undergrowth tries again at its next monthly cycle."
msgstr ""


{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "undergrowth/garden-count",
	"version": "0.1.0",
	"title": "Garden count",
	"category": "widgets",
	"icon": "chart-bar",
	"description": "Shows how many posts readers can find in your garden.",
	"keywords": [ "garden", "count", "number", "posts" ],
	"textdomain": "undergrowth",
	"attributes": {
		"showLabel": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "undergrowth/growth-stage",
	"version": "0.1.0",
	"title": "Growth stage",
	"category": "theme",
	"icon": "awards",
	"description": "Shows the post's growth stage: Seedling, Sprout, Budding or Evergreen. Composting posts show nothing.",
	"keywords": [ "seedling", "sprout", "evergreen", "badge" ],
	"textdomain": "undergrowth",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"showIcon": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js"
}

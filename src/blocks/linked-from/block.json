{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "undergrowth/linked-from",
	"version": "0.1.0",
	"title": "Linked from",
	"category": "theme",
	"icon": "admin-links",
	"description": "Lists your published posts that link to this one through a link you accepted in Undergrowth.",
	"keywords": [ "backlinks", "links", "garden" ],
	"textdomain": "undergrowth",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"maxItems": {
			"type": "integer",
			"default": 5,
			"minimum": 1,
			"maximum": 20
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"editorScript": "file:./index.js"
}

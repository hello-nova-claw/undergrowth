{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "undergrowth/garden-index",
	"version": "0.1.0",
	"title": "Garden index",
	"category": "widgets",
	"icon": "networking",
	"description": "Lists your published posts by the groups on the Map, each with its growth stage, so readers can wander the garden by topic.",
	"keywords": [ "garden", "map", "topics", "index" ],
	"textdomain": "undergrowth",
	"attributes": {
		"stage": {
			"type": "string",
			"enum": [ "", "seedling", "sprout", "budding", "evergreen" ],
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"editorScript": "file:./index.js"
}

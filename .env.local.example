# Copy this file to .env.local, which git ignores, and fill it in.
# Used only by `npm run playground:real`. See docs/testing-v1.md.

# How posts are read: ollama (free, on this computer) or openai.
# Left empty, it is ollama unless OPENAI_API_KEY is set.
UNDERGROWTH_EMBEDDINGS=ollama

# Only for openai: a key from a separate OpenAI project with a low monthly budget.
OPENAI_API_KEY=

# Optional, in either mode. Turns on the questions on the Dashboard.
ANTHROPIC_API_KEY=

# Optional. A WordPress export (Tools > Export) to import, relative to this folder or absolute.
WXR=

{
	"name": "undergrowth",
	"private": true,
	"description": "Links your posts to each other in your own words, and shows you what your archive is really about. The AI reads; you decide.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"playground": "wp-playground-cli server $(node bin/plugin-mounts.cjs) --mount=./tests/e2e/mu-plugins:/wordpress/wp-content/mu-plugins --mount=./demo:/wordpress/wp-content/undergrowth-demo --blueprint=tests/e2e/playground/preview.json",
		"playground:real": "node bin/playground-real.mjs",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style --allow-empty-input",
		"check:native": "node bin/check-native.js",
		"test:js": "wp-scripts test-unit-jest --passWithNoTests",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/undergrowth vendor/bin/phpunit",
		"test:php:multisite": "wp-env run tests-cli --env-cwd=wp-content/plugins/undergrowth vendor/bin/phpunit -c phpunit-multisite.xml.dist",
		"test:e2e": "wp-scripts test-playwright --pass-with-no-tests",
		"screenshots": "playwright test -c playwright.screenshots.config.js",
		"test:a11y": "node bin/pa11y.mjs",
		"i18n:pot": "vendor/bin/wp i18n make-pot . languages/undergrowth.pot --exclude=artifacts,bin,changelog,dist,docs,node_modules,tests,vendor && node bin/stable-pot.js languages/undergrowth.pot",
		"changelog": "node bin/changelog.js",
		"i18n:pseudo": "node bin/pseudo-locale.mjs languages/undergrowth.pot"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@jest/globals": "^30.5.2",
		"@playwright/test": "^1.64.1",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/babel-preset-default": "^10.0.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/e2e-test-utils-playwright": "^3.0.0",
		"@wordpress/editor": "^15.2.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/notices": "^5.57.0",
		"@wordpress/plugins": "^7.57.0",
		"@wordpress/scripts": "^37.0.0",
		"@wordpress/server-side-render": "^6.33.0",
		"@wp-playground/cli": "^3.1.59",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"pa11y-ci": "^5.0.0",
		"pixelmatch": "^8.0.0",
		"pngjs": "^7.0.0"
	}
}

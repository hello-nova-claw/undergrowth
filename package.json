{
	"name": "undergrowth",
	"private": true,
	"description": "Uses AI to read your site and ask you questions. It never writes a word your readers will see.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"lint:js": "wp-scripts lint-js",
		"test:js": "wp-scripts test-unit-js --passWithNoTests",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/undergrowth vendor/bin/phpunit",
		"test:e2e": "wp-scripts test-playwright --pass-with-no-tests",
		"test:a11y": "pa11y-ci",
		"i18n:pot": "wp-env run cli --env-cwd=wp-content/plugins/undergrowth wp i18n make-pot . languages/undergrowth.pot --exclude=artifacts,bin,dist,docs,node_modules,tests,vendor",
		"i18n:pseudo": "node bin/pseudo-locale.mjs languages/undergrowth.pot"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@wordpress/e2e-test-utils-playwright": "^3.0.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/scripts": "^36.1.0",
		"pa11y-ci": "^5.0.0"
	}
}

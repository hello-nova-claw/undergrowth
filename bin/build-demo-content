#!/usr/bin/env -S python3 -I
"""Builds the demo blog: public-domain books split into posts, as WXR files.

The demo blog is for demos, screenshots, Playground previews and testing, so
that nobody's own writing is ever needed. Every word in it was written by the
books' authors, long dead. Titles come from their own chapter headings and
nothing is written, summarised or titled by a model. See docs/demo-content.md.

Usage: python3 -I bin/build-demo-content [--cache DIR] [--out DIR]

The plain-text books are downloaded from gutenberg.org into the cache
directory, by default ~/.cache/undergrowth-demo-content, once. Each download
is checked against the hash recorded below, so the same books always give
the same files, byte for byte. The texts are read as plain text and nothing
in them is run. Writes undergrowth-demo.xml and undergrowth-demo-small.xml
to the output directory, by default demo/.
"""
import argparse
import hashlib
import html
import math
import os
import re
import sys
import time
import urllib.request
from datetime import datetime, timedelta
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# Each book: its Gutenberg number and the hash of the plain-text file used,
# where its text starts and ends, and how its chapters are headed.
#
# start: a line where the text starts. start_hit picks which of the
#   unindented lines matching it, for books whose contents list repeats it.
# end: the first line after the text.
# heading: a chapter heading. Its first group, if any, is the title.
# title_next: the heading is a number, and the next line holds the title.
# entry: for a diary, the dated start of an entry, which starts a section.
# indented: headings may be indented, as some subheadings are.
# drop: lines that are neither text nor a chapter, such as part numbers.
# pages: front matter used as a page: (title, start, end).
BOOKS = [

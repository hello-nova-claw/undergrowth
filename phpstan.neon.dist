parameters:
	level: 6
	phpVersion: 70400
	# Filter callbacks belong to other plugins, so a hook's documented type is a
	# promise nobody enforces. Keep the runtime checks PHPStan would call redundant.
	treatPhpDocTypesAsCertain: false
	paths:
		- undergrowth.php
		- src
		- uninstall.php
	# Jetpack is not a dependency. The meter's stand-ins give its signatures.
	scanFiles:
		- tests/phpunit/includes/class-modules.php
		- tests/phpunit/includes/class-manager.php
		- tests/phpunit/includes/class-wpcom-stats.php
